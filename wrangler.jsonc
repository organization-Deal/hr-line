{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hr-line",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/auth/*", "/integrations/*", "/webhooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
