{
  "name": "nakna-hr",
  "version": "1.0.80",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed.sql",
    "check": "node --check src/index.js && node --check public/app.js && node --check public/invite.js && node --check public/learn.js && node --check public/leave.js && node --check public/attendance.js",
    "audit": "npm run check && node scripts/audit.mjs"
  },
  "devDependencies": {
    "wrangler": "latest"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1"
  }
}
